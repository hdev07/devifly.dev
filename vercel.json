{
  "redirects": [
    { "source": "/products", "destination": "/#productos", "permanent": true },
    { "source": "/pricing", "destination": "/#precios", "permanent": true },
    { "source": "/enfoque", "destination": "/#enfoque", "permanent": true },
    { "source": "/solutions", "destination": "/#enfoque", "permanent": true },
    { "source": "/case-studies", "destination": "/#casos", "permanent": true },
    { "source": "/contact", "destination": "/contacto", "permanent": true },
    { "source": "/landings", "destination": "/landing-pages", "permanent": true },
    { "source": "/landings/demo", "destination": "/landing-pages/demo", "permanent": true },
    { "source": "/catalogos-nenis", "destination": "/catalogos", "permanent": true },
    { "source": "/catalogos-nenis/:tier(esencial|pro|premium)", "destination": "/catalogos/:tier", "permanent": true },
    { "source": "/catalogos-nenis/demo", "destination": "/catalogos/premium", "permanent": true },
    { "source": "/invitaciones/demo", "destination": "/invitaciones/premium", "permanent": true },
    { "source": "/menus-digitales/demo", "destination": "/menus-digitales/premium", "permanent": true },
    { "source": "/catalogos/demo", "destination": "/catalogos/premium", "permanent": true },
    { "source": "/salones-eventos/demo", "destination": "/salones-eventos/premium", "permanent": true }
  ],
  "rewrites": [
    { "source": "/p/:doc", "destination": "/p/:doc.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/p/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
