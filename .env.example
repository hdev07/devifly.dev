# Copia este archivo a .env y rellena los valores. .env está en .gitignore.

# Clave de Resend, cuenta con devifly.dev verificado.
# La usa scripts/send-quote-email.mjs para mandar cotizaciones a clientes.
# Sin prefijo VITE_ a propósito: así Vite nunca la mete en el bundle del navegador.
RESEND_API_KEY=

# Cloudflare Turnstile — formulario de contacto.
# Site key (pública): se expone al navegador vía Vite.
VITE_CF_TURNSTILE_SITE_KEY=
# Secret key (privada): solo en el servidor, nunca en el bundle.
CF_TURNSTILE_SECRET_KEY=

# Overrides opcionales de scripts/send-quote-email.mjs.
# QUOTE_TO=cliente@ejemplo.com
# QUOTE_FROM=Devifly <hola@devifly.dev>
# QUOTE_REPLY_TO=devifly.dev@gmail.com
# QUOTE_URL=https://devifly.dev/p/white-glove-corrections-8cf7ecec
